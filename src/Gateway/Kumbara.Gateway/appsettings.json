{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Jwt": {
    "Issuer": "http://localhost:5001",
    "Audience": "kumbara-api",
    "Secret": "KumbaraSuperSecretKeyForJwtAuthenticationValidation2024!"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/wallets/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      },
      "ledger-route": {
        "ClusterId": "ledger-cluster",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      },
      "transfer-route": {
        "ClusterId": "transfer-cluster",
        "Match": {
          "Path": "/api/transfers/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      },
      "risk-route": {
        "ClusterId": "risk-cluster",
        "Match": {
          "Path": "/api/risk/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "RateLimiterPolicy": "fixed-by-ip"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-destination": {
            "Address": "http://wallet-api:8080"
          }
        }
      },
      "ledger-cluster": {
        "Destinations": {
          "ledger-destination": {
            "Address": "http://ledger-api:8080"
          }
        }
      },
      "transfer-cluster": {
        "Destinations": {
          "transfer-destination": {
            "Address": "http://transfer-api:8080"
          }
        }
      },
      "risk-cluster": {
        "Destinations": {
          "risk-destination": {
            "Address": "http://risk-api:8080"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
