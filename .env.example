# =============================================================================
# Kumbara Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server
# -----------------------------------------------------------------------------
SA_PASSWORD=Your_Strong_Password_123!
MSSQL_PID=Developer

# Connection strings (used by services)
IDENTITY_DB_CONNECTION=Server=sqlserver;Database=Kumbara.Identity;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True
WALLET_DB_CONNECTION=Server=sqlserver;Database=Kumbara.Wallet;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True
LEDGER_DB_CONNECTION=Server=sqlserver;Database=Kumbara.Ledger;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True
TRANSFER_DB_CONNECTION=Server=sqlserver;Database=Kumbara.Transfer;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True
RISK_DB_CONNECTION=Server=sqlserver;Database=Kumbara.Risk;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CONNECTION=redis:6379
REDIS_INSTANCE_NAME=kumbara_

# -----------------------------------------------------------------------------
# Seq (Structured Logging)
# -----------------------------------------------------------------------------
SEQ_URL=http://seq:5341
SEQ_API_KEY=

# -----------------------------------------------------------------------------
# Identity / OpenIddict
# -----------------------------------------------------------------------------
IDENTITY_ISSUER=http://localhost:5101
JWT_AUTHORITY=http://identity:5101
JWT_AUDIENCE=kumbara-api

# -----------------------------------------------------------------------------
# Service URLs (internal, for Docker networking)
# -----------------------------------------------------------------------------
IDENTITY_URL=http://identity:5101
WALLET_URL=http://wallet:5102
LEDGER_URL=http://ledger:5103
TRANSFER_URL=http://transfer:5104
RISK_URL=http://risk:5105
GATEWAY_URL=http://gateway:5000

# -----------------------------------------------------------------------------
# Service Ports (external, for host access)
# -----------------------------------------------------------------------------
GATEWAY_PORT=5000
IDENTITY_PORT=5101
WALLET_PORT=5102
LEDGER_PORT=5103
TRANSFER_PORT=5104
RISK_PORT=5105

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
TZ=UTC
