# =============================================================================
# ⚠️ SIMULATION ONLY - NO REAL MONEY ⚠️
# "Bu proje eğitim ve araştırma amaçlı bir simülasyondur.
#  Gerçek para transferi yapılmaz. Herhangi bir gerçek finansal kuruluşla ilişkisi yoktur."
# Educational fintech platform simulation - No real financial transactions.
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' at the repository root or in the deploy/ folder:
#    cp .env.example .env
# 2. Adjust passwords and secrets as appropriate for your environment.
# 3. DO NOT commit actual secrets or the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Microsoft SQL Server 2022
# -----------------------------------------------------------------------------
SA_PASSWORD=Your_Strong_Password_123!
MSSQL_PID=Developer
MSSQL_PORT=1433

# Connection Strings (used by individual microservices)
IDENTITY_DB_CONNECTION=Server=sqlserver;Database=KumbaraIdentityDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true
WALLET_DB_CONNECTION=Server=sqlserver;Database=KumbaraWalletDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true
LEDGER_DB_CONNECTION=Server=sqlserver;Database=KumbaraLedgerDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true
TRANSFER_DB_CONNECTION=Server=sqlserver;Database=KumbaraTransferDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true
RISK_DB_CONNECTION=Server=sqlserver;Database=KumbaraRiskDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true

# -----------------------------------------------------------------------------
# RabbitMQ Message Broker
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# Redis Distributed Cache & Locks
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION=redis:6379
REDIS_INSTANCE_NAME=kumbara_

# -----------------------------------------------------------------------------
# Datalust Seq (Structured Logging)
# -----------------------------------------------------------------------------
SEQ_INGESTION_PORT=5341
SEQ_UI_PORT=8081
SEQ_URL=http://seq:5341
SEQ_API_KEY=

# -----------------------------------------------------------------------------
# Identity / JWT / OpenIddict Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=DevSuperSecretKeyForKumbaraFintechPlatform2026!
JWT_ISSUER=http://identity-api:8080
JWT_AUDIENCE=kumbara-clients
IDENTITY_ISSUER=http://localhost:5001

# -----------------------------------------------------------------------------
# External Service Ports (Mapped to host)
# -----------------------------------------------------------------------------
GATEWAY_PORT=5000
IDENTITY_PORT=5001
WALLET_PORT=5002
LEDGER_PORT=5003
TRANSFER_PORT=5004
RISK_PORT=5005
NOTIFICATION_PORT=5006
WEB_UI_PORT=4200

# -----------------------------------------------------------------------------
# Internal Service URLs (Docker Network Resolution)
# -----------------------------------------------------------------------------
IDENTITY_URL=http://identity-api:8080
WALLET_URL=http://wallet-api:8080
LEDGER_URL=http://ledger-api:8080
TRANSFER_URL=http://transfer-api:8080
RISK_URL=http://risk-api:8080
NOTIFICATION_URL=http://notification-api:8080
GATEWAY_URL=http://gateway:8080
WEB_UI_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# ASP.NET Core & Runtime Environment
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
TZ=UTC
